# Public-safe example only. Copy to ignored data/config/ai26/laskin.env and fill private values.
LACLAUGPT_PROJECT_ID=ai26
LACLAUGPT_MACHINE=linux-server
LACLAUGPT_EXECUTION=cron
LACLAUGPT_STORAGE=distributed
LACLAUGPT_DATA_BACKEND=mongodb
LACLAUGPT_CACHE_BACKEND=redis
LACLAUGPT_OBJECT_BACKEND=s3
LACLAUGPT_PRIVATE_CONFIG_DIR=/private/path/to/ai26
LACLAUGPT_RUN_ID=<shared-ai26-run-id>
LACLAUGPT_MONGODB_URI=<remote-mongodb-uri>
LACLAUGPT_MONGO_DATABASE=laclaugpt
LACLAUGPT_REDIS_URL=<remote-redis-url>
LACLAUGPT_S3_BUCKET=<shared-ai26-bucket>
LACLAUGPT_S3_ADDRESSING_STYLE=auto
LACLAUGPT_S3_SIGNATURE_VERSION=auto
LACLAUGPT_S3_PREFIX_ROOT=projects
# If this account has been configured with CSC allas-conf, boto3 uses the
# generated ~/.aws/credentials and ~/.aws/config automatically. Do not put CSC
# passwords or S3 access/secret keys in this env file.
# Generic/explicit overrides are optional:
# LACLAUGPT_S3_ENDPOINT=https://a3s.fi
# LACLAUGPT_S3_REGION=
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODE=local
LLM_ALLOW_CLOUD_FALLBACK=0
LACLAUGPT_OLLAMA_MODEL=gemma4:12b
LACLAUGPT_MAX_TASKS=10
LACLAUGPT_RECLAIM_IDLE_MS=300000
