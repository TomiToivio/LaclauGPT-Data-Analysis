# Safe example only. Runtime material belongs under data/.

# Local laptop defaults
LACLAUGPT_PROFILE=local
LACLAUGPT_MACHINE=laptop
LACLAUGPT_EXECUTION=cli
LACLAUGPT_STORAGE=local
LACLAUGPT_LLM_MODE=local-ollama
LACLAUGPT_LLM_MODEL=gemma4:e4b
LACLAUGPT_LLM_ENDPOINT=http://127.0.0.1:11434
LACLAUGPT_CLOUD_ALLOWED=false
LACLAUGPT_CALLER=human-cli
# Backend precedence: an explicit LACLAUGPT_STORAGE_BACKEND overrides
# LACLAUGPT_DATA_BACKEND; when STORAGE_BACKEND is unset/auto, DATA_BACKEND is used.
# Distributed storage fails closed unless the effective backend is MongoDB.
LACLAUGPT_DATA_BACKEND=csv
LACLAUGPT_DATABASE_URL=sqlite:///./data/database/analysis.sqlite3
LACLAUGPT_DATA_DIR=./data
LACLAUGPT_ARTIFACT_DIR=./data/artifacts
LACLAUGPT_CACHE_BACKEND=memory
LACLAUGPT_OBJECT_BACKEND=local

# Optional/experimental theory layers are opt-in and disabled by default.
LACLAUGPT_LUHMANN_ENABLED=false
LACLAUGPT_LUHMANN_CODEBOOK=codebooks/public/luhmann_social_systems_v1.yaml
LACLAUGPT_CASTELLS_ENABLED=false

# Same-machine Collection -> Analysis path. Configure privately for your checkout.
# LACLAUGPT_COLLECTION_DATA_DIR=/PATH/TO/COLLECTION/data

# Roihu/HPC example dimensions. Site-specific project, partition and scratch stay private.
# LACLAUGPT_MACHINE=roihu
# LACLAUGPT_EXECUTION=slurm
# LACLAUGPT_LLM_MODE=local-ollama
# LACLAUGPT_LLM_MODEL=gemma4:26b
# LACLAUGPT_CALLER=scheduler
# LACLAUGPT_SCRATCH_DIR=/PRIVATE/SCRATCH/PATH

# Explicit laptop cloud example. Never enable this silently.
# LACLAUGPT_LLM_MODE=ollama-cloud
# LACLAUGPT_LLM_MODEL=gemma4:31b-cloud
# LACLAUGPT_CLOUD_ALLOWED=true

# Optional distributed topology
# LACLAUGPT_MACHINE=linux-server
# LACLAUGPT_EXECUTION=cron
# LACLAUGPT_STORAGE=distributed
# LACLAUGPT_LLM_MODEL=gemma4:12b
# LACLAUGPT_DATA_BACKEND=mongodb
# Optional explicit override equivalent for this topology:
# LACLAUGPT_STORAGE_BACKEND=mongodb
# LACLAUGPT_MONGO_URL=mongodb://HOST:27017
# LACLAUGPT_MONGO_DATABASE=laclaugpt
# LACLAUGPT_CACHE_BACKEND=redis
# LACLAUGPT_REDIS_URL=redis://HOST:6379/0
# LACLAUGPT_OBJECT_BACKEND=s3
# LACLAUGPT_S3_BUCKET=BUCKET-NAME
# CSC Allas: run allas-conf for the Unix account. boto3 uses the generated
# ~/.aws/credentials and ~/.aws/config, so do not duplicate passwords or keys here.
# LACLAUGPT_S3_SIGNATURE_VERSION=s3
# LACLAUGPT_S3_ADDRESSING_STYLE=virtual
# Optional generic S3 overrides when shared AWS config does not provide them:
# LACLAUGPT_S3_ENDPOINT_URL=https://OBJECT-STORAGE-ENDPOINT
# LACLAUGPT_S3_REGION=REGION
