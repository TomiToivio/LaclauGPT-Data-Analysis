# Laskin runtime config for the AI26 distributed collection run.
# Gitignored. Shares the laptop MongoDB/Redis/Allas project namespace.
# Values verified live 2026-09-16; never commit this file.

# Machine / execution identity (cron-only, no browser).
LACLAUGPT_PROJECT_ID=
LACLAUGPT_RUN_ID=
LACLAUGPT_PROFILE=
LACLAUGPT_MACHINE=
LACLAUGPT_EXECUTION=
LACLAUGPT_BROWSER=
LACLAUGPT_CALLER=
LACLAUGPT_DATA_ROOT=

# Fail-closed private config root (must contain the study config + manifest).
LACLAUGPT_PRIVATE_CONFIG_DIR=

# Distributed backends.
LACLAUGPT_RECORD_BACKEND=
LACLAUGPT_OBJECT_BACKEND=
LACLAUGPT_CACHE_BACKEND=
LACLAUGPT_MESSAGING_BACKEND=

LACLAUGPT_MONGODB_URI=
LACLAUGPT_MONGODB_DATABASE=
LACLAUGPT_REDIS_URL=

LACLAUGPT_S3_ENDPOINT_URL=
LACLAUGPT_S3_REGION=
LACLAUGPT_S3_BUCKET=
LACLAUGPT_S3_ACCESS_KEY_ID=
LACLAUGPT_S3_SECRET_ACCESS_KEY=

# CSC Allas requires signature v2 and non-path addressing for uploads.
LACLAUGPT_S3_SIGNATURE_VERSION=s3
LACLAUGPT_S3_ADDRESSING_STYLE=auto
# Canonical AI26 profile (configs/ai26.laskin-remote.example.toml): Laskin
# resolves the shared distributed configuration from Redis, while messaging
# and task queues stay dormant by design.
LACLAUGPT_DISTRIBUTED_CONFIG_BACKEND=
# Mapbox
LACLAUGPT_MAPBOX_API_KEY=your_mapbox_api_key_here