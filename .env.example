# Safe example only. Do not put real credentials in this file.

# Local laptop defaults
LACLAUGPT_PROFILE=local
LACLAUGPT_DATA_BACKEND=csv
LACLAUGPT_DATABASE_URL=sqlite:///./var/laclaugpt.db
LACLAUGPT_DATA_DIR=./var/data
LACLAUGPT_ARTIFACT_DIR=./var/artifacts
LACLAUGPT_CACHE_BACKEND=memory
LACLAUGPT_OBJECT_BACKEND=local

# Optional distributed profile. Uncomment locally and supply credentials
# through your shell, deployment tooling or secret manager.
# LACLAUGPT_PROFILE=server
# LACLAUGPT_DATA_BACKEND=mongodb
# LACLAUGPT_MONGO_URL=mongodb://HOST:27017
# LACLAUGPT_MONGO_DATABASE=laclaugpt
# LACLAUGPT_CACHE_BACKEND=redis
# LACLAUGPT_REDIS_URL=redis://HOST:6379/0
# LACLAUGPT_OBJECT_BACKEND=s3
# LACLAUGPT_S3_ENDPOINT_URL=https://OBJECT-STORAGE-ENDPOINT
# LACLAUGPT_S3_BUCKET=BUCKET-NAME
# LACLAUGPT_S3_REGION=REGION
