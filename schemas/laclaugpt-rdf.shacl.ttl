@prefix laclaugpt: <https://w3id.org/laclaugpt/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Synced from TomiToivio/LaclauGPT/schemas/laclaugpt-rdf.shacl.ttl.
# The meta-repository remains authoritative.

laclaugpt:ArticulationShape a sh:NodeShape ;
    sh:targetClass laclaugpt:Articulation ;
    sh:property [
        sh:path laclaugpt:articulates ;
        sh:minCount 2 ;
        sh:message "An articulation must connect at least two articulated resources."@en
    ] ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:minCount 1 ;
        sh:message "An analytical articulation must retain generation provenance."@en
    ] ;
    sh:property [
        sh:path laclaugpt:reviewState ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:in ("PROVISIONAL" "ACCEPTED" "REJECTED" "REVISED" "CANONICAL" "SUPERSEDED")
    ] ;
    sh:property [
        sh:path laclaugpt:confidence ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1
    ] .

laclaugpt:SignifierRoleShape a sh:NodeShape ;
    sh:targetClass laclaugpt:EmptySignifier, laclaugpt:FloatingSignifier, laclaugpt:NodalPoint ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:minCount 1 ;
        sh:message "Theory-specific signifier-role claims must retain provenance."@en
    ] ;
    sh:property [
        sh:path laclaugpt:reviewState ;
        sh:minCount 1 ;
        sh:datatype xsd:string
    ] .

# Phase 1 AI26 analytical projection. These shapes intentionally validate the
# semantic RDF projection rather than redefining CanonicalRecord as RDF-first.
laclaugpt:Phase1ConceptShape a sh:NodeShape ;
    sh:targetClass laclaugpt:Discourse, laclaugpt:SociotechnicalImaginary,
        laclaugpt:CollectiveSubject, laclaugpt:OpposingSubject,
        laclaugpt:DiscursiveFrontier, laclaugpt:Affect ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:minCount 1 ;
        sh:message "Phase 1 analytical concepts must retain generation provenance."@en
    ] ;
    sh:property [
        sh:path laclaugpt:reviewState ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:in ("PROVISIONAL" "ACCEPTED" "REJECTED" "REVISED" "CANONICAL" "SUPERSEDED")
    ] ;
    sh:property [
        sh:path laclaugpt:confidence ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1
    ] .

laclaugpt:DiscourseChainShape a sh:NodeShape ;
    sh:targetClass laclaugpt:EquivalenceChain, laclaugpt:DifferenceChain ;
    sh:property [
        sh:path laclaugpt:hasMember ;
        sh:minCount 2 ;
        sh:message "A discourse chain must contain at least two members."@en
    ] ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path laclaugpt:reviewState ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:in ("PROVISIONAL" "ACCEPTED" "REJECTED" "REVISED" "CANONICAL" "SUPERSEDED")
    ] .

laclaugpt:PopulismFormulaShape a sh:NodeShape ;
    sh:targetClass laclaugpt:PopulismFormula ;
    sh:property [
        sh:path laclaugpt:hasComponent ;
        sh:minCount 1 ;
        sh:message "A Formula of Populism must retain at least one component."@en
    ] ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path laclaugpt:reviewState ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:in ("PROVISIONAL" "ACCEPTED" "REJECTED" "REVISED" "CANONICAL" "SUPERSEDED")
    ] .
